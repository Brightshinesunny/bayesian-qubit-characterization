        RowBox[{"(", 
         RowBox[{"\:b77c\:be44", " ", "\:c9c4\:b3d9\:c218"}], ")"}]}]}]}]}]}],
    "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"signalModel", "[", 
      RowBox[{"t_", ",", "A_", ",", "gamma_", ",", "omega_"}], "]"}], ":=", 
     RowBox[{"A", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "gamma"}], "*", "t"}], "]"}], "*", 
      RowBox[{"Cos", "[", 
       RowBox[{"omega", "*", "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"trueA", "=", "1.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"trueGamma", "=", "0.1"}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"1", "/", "\[Mu]s"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"trueOmega", "=", 
     RowBox[{"2.0", "*", "Pi", "*", "5.0"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"5", " ", "MHz"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"trueParams", "=", 
     RowBox[{"{", 
      RowBox[{"trueA", ",", "trueGamma", ",", "trueOmega"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Generate", " ", "Mock", " ", "Experimental", " ", "Data"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "\:c911\:b825\:d30c\:c758", " ", "strain", " ", "\:b370\:c774\:d130", 
      " ", "d", 
      RowBox[{"(", "t", ")"}]}], "=", 
     RowBox[{
      RowBox[{"h", 
       RowBox[{"(", "t", ")"}]}], "+", 
      RowBox[{"n", 
       RowBox[{"(", "t", ")"}], " ", "\:b97c", " ", 
       "\:c0dd\:c131\:d558\:b294", " ", 
       RowBox[{"\:acfc\:c815\:c785\:b2c8\:b2e4", "."}]}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tMin", "=", "0.0"}], ";", 
    RowBox[{"tMax", "=", "10.0"}], ";", 
    RowBox[{"nPoints", "=", "500"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tData", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"tMin", ",", "tMax", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"tMax", "-", "tMin"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"nPoints", "-", "1"}], ")"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"sigmaNoise", "=", "0.05"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Readout", " ", "Noise", " ", "Level"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "1234", "]"}], ";"}], "  ", 
   RowBox[{"(*", "Reproducibility", "*)"}], "\n", 
   RowBox[{
    RowBox[{"mockNoise", "=", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", "sigmaNoise"}], "]"}], ",", "nPoints"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"mockSignal", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"signalModel", "[", 
        RowBox[{"t", ",", "trueA", ",", "trueGamma", ",", "trueOmega"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tData"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mockData", "=", 
     RowBox[{"mockSignal", "+", "mockNoise"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Mock", " ", "Data", " ", "Plot"}], "*)"}], "\n", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"{", 
       RowBox[{"tData", ",", "mockData"}], "}"}], "]"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.005", "]"}], ",", "Gray"}], "]"}]}], ",", 
     RowBox[{"Joined", "->", "False"}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<Mock Superconducting Qubit Readout Signal\>\""}],
      ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Time (us)\>\"", ",", "\"\<Signal (a.u.)\>\""}], "}"}]}]}],
     "]"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Fisher", " ", "Information", " ", "Matrix", " ", 
     RowBox[{"(", "FIM", ")"}], " ", "Calculation"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "\:c911\:b825\:d30c", " ", "\:d30c\:d615\:c758", " ", 
     "\:bbf8\:bd84\:ac12", " ", 
     RowBox[{"d_h", "/", "d_theta\:b97c"}], " ", "\:acc4\:c0b0\:d558\:c5ec", 
     " ", "\:d53c\:c154", " ", "\:d589\:b82c\:c744", " ", 
     "\:ad6c\:d558\:b294", " ", "\:d575\:c2ec", " ", 
     RowBox[{"\:c54c\:ace0\:b9ac\:c998\:c785\:b2c8\:b2e4", "."}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"params", "=", 
     RowBox[{"{", 
      RowBox[{"A", ",", "gamma", ",", "omega"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"derivatives", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"signalModel", "[", 
          RowBox[{"t", ",", "A", ",", "gamma", ",", "omega"}], "]"}], ",", 
         "p"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", "params"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "\:b370\:c774\:d130", " ", "\:c9c0\:c810\:c5d0\:c11c", " ", 
     "\:bbf8\:bd84\:ac12", " ", "\:c0b0\:cd9c"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"derivMatrix", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"derivatives", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"A", "->", "trueA"}], ",", 
          RowBox[{"gamma", "->", "trueGamma"}], ",", 
          RowBox[{"omega", "->", "trueOmega"}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tData"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Fisher", " ", "Information", " ", 
      RowBox[{"Matrix", ":", "F_ij"}]}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"sigma", "^", "2"}]}], ")"}], "*", "Sum", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"dS", "/", "d_theta"}], "_i"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"dS", "/", "d_theta"}], "_j"}], ")"}]}], ")"}]}]}], "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"fisherMatrix", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"sigmaNoise", "^", "2"}]}], ")"}], "*", 
      RowBox[{
       RowBox[{"Transpose", "[", "derivMatrix", "]"}], ".", 
       "derivMatrix"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Fisher Information Matrix:\>\"", "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"MatrixForm", "[", "fisherMatrix", "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Cramer", "-", 
     RowBox[{"Rao", " ", "Lower", " ", "Bound", " ", 
      RowBox[{"(", "CRLB", ")"}]}], "-", 
     RowBox[{"\:acf5\:bd84\:c0b0", " ", "\:d589\:b82c", " ", 
      RowBox[{"(", 
       RowBox[{"Covariance", " ", "Matrix"}], ")"}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "\:c911\:b825\:d30c\:c758", " ", "\:d30c\:b77c\:bbf8\:d130", " ", 
      "\:c624\:cc28", " ", "\:ce21\:c815", " ", "\:d55c\:acc4", " ", 
      "sigma_theta"}], "=", 
     RowBox[{
      RowBox[{"Sqrt", "[", "Cov_ii", "]"}], " ", "\:acc4\:c0b0\:acfc", " ", 
      "\:c644\:bcbd\:d788", " ", 
      RowBox[{"\:c77c\:ce58\:d569\:b2c8\:b2e4", "."}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"covMatrix", "=", 
     RowBox[{"Inverse", "[", "fisherMatrix", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"paramErrors", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Diagonal", "[", "covMatrix", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Expected Parameter Uncertainties (CRLB):\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\"\<sigma_A\>\"", ",", "\"\<sigma_gamma\>\"", ",", 
         "\"\<sigma_omega\>\""}], "}"}], "->", "paramErrors"}], "]"}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"4.", " ", "Bayesian", " ", "Likelihood"}], "&"}], " ", "MCMC", 
     " ", "Sampling"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"\:c911\:b825\:d30c", " ", 
     RowBox[{"LALInference", "/", "Bilby"}], " ", "\:c5d0\:c11c", " ", 
     "\:c218\:d589\:d558\:b294", " ", "posterior", " ", "P", 
     RowBox[{"(", 
      RowBox[{"theta", "|", "d"}], ")"}], " ", "\:c0d8\:d50c\:b9c1", " ", 
     RowBox[{"\:acfc\:c815\:c785\:b2c8\:b2e4", "."}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"logLikelihood", "[", 
      RowBox[{"A_Real", ",", "gamma_Real", ",", "omega_Real"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "res", "}"}], ",", 
       RowBox[{
        RowBox[{"res", "=", 
         RowBox[{"mockData", "-", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"signalModel", "[", 
             RowBox[{"t", ",", "A", ",", "gamma", ",", "omega"}], "]"}], ",", 
            
            RowBox[{"{", 
             RowBox[{"t", ",", "tData"}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"-", "0.5"}], "*", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"res", "^", "2"}], "]"}], "/", 
          RowBox[{"sigmaNoise", "^", "2"}]}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Flat", " ", "Priors"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"logPrior", "[", 
      RowBox[{"A_", ",", "gamma_", ",", "omega_"}], "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"0.5", "<", "A", "<", "1.5"}], "&&", 
        RowBox[{"0.0", "<", "gamma", "<", "0.5"}], "&&", 
        RowBox[{
         RowBox[{"2", "*", "Pi", "*", "4.0"}], "<", "omega", "<", 
         RowBox[{"2", "*", "Pi", "*", "6.0"}]}]}], ",", "0.0", ",", 
       RowBox[{"-", "Infinity"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"logPosterior", "[", "p_List", "]"}], ":=", 
     RowBox[{
      RowBox[{"logPrior", "[", 
       RowBox[{
        RowBox[{"p", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"p", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"p", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "+", 
      RowBox[{"logLikelihood", "[", 
       RowBox[{
        RowBox[{"p", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"p", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"p", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"MCMC", " ", "Sampling", " ", 
     RowBox[{"(", 
      RowBox[{"Metropolis", "-", "Hastings"}], ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
    "Needs", "[", "\"\<DifferentialEquations`NDSolveProblems`\>\"", "]"}], 
    ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Standard", " ", "Utilities"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"\:ac04\:b2e8\:d55c", " ", "random", " ", "walk", " ", "MCMC"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"nMCMC", "=", "5000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"samples", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.0", ",", 
       RowBox[{"{", 
        RowBox[{"nMCMC", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"currentP", "=", 
     RowBox[{"trueParams", "+", 
      RowBox[{"{", 
       RowBox[{"0.02", ",", "0.005", ",", "0.05"}], "}"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Initial", " ", "state", " ", "slightly", " ", "off"}], "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"currentLogP", "=", 
     RowBox[{"logPosterior", "[", "currentP", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"proposal", "=", 
        RowBox[{"currentP", "+", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{"MultivariateNormalDistribution", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
            RowBox[{
             RowBox[{"DiagonalMatrix", "[", 
              RowBox[{"{", 
               RowBox[{"0.002", ",", "0.0005", ",", "0.01"}], "}"}], "]"}], 
             "^", "2"}]}], "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"propLogP", "=", 
        RowBox[{"logPosterior", "[", "proposal", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"RandomReal", "[", "]"}], "]"}], "<", 
          RowBox[{"propLogP", "-", "currentLogP"}]}], ",", 
         RowBox[{
          RowBox[{"currentP", "=", "proposal"}], ";", "\[IndentingNewLine]", 
          RowBox[{"currentLogP", "=", "propLogP"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"samples", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "=", "currentP"}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "nMCMC"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Burn", "-", 
     RowBox[{
     "in", " ", "\:c81c\:ac70", " ", "\:bc0f", " ", "Posterior", " ", 
      "\:bd84\:c0b0", " ", "\:d655\:c778"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"postSamples", "=", 
     RowBox[{"Drop", "[", 
      RowBox[{"samples", ",", "1000"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<MCMC Estimated Parameters (Mean +/- Std):\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<A: \>\"", ",", 
      RowBox[{"Mean", "[", 
       RowBox[{"postSamples", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], ",", "\"\< +/- \>\"",
       ",", 
      RowBox[{"StandardDeviation", "[", 
       RowBox[{"postSamples", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<gamma: \>\"", ",", 
      RowBox[{"Mean", "[", 
       RowBox[{"postSamples", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], ",", "\"\< +/- \>\"",
       ",", 
      RowBox[{"StandardDeviation", "[", 
       RowBox[{"postSamples", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<omega: \>\"", ",", 
      RowBox[{"Mean", "[", 
       RowBox[{"postSamples", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}], ",", "\"\< +/- \>\"",
       ",", 
      RowBox[{"StandardDeviation", "[", 
       RowBox[{"postSamples", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
