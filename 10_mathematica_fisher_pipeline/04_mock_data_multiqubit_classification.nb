        "\[IndentingNewLine]", 
        RowBox[{"errs", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"CovMat", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "i"}], "]"}], "]"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "CovMat", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"corrMat", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"CovMat", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], "/", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"CovMat", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "i"}], "]"}], "]"}], "*", 
               RowBox[{"CovMat", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "j"}], "]"}], "]"}]}], "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "4"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", 
         "\"\<\\n==================================================\>\"", 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", 
         "\"\<   [2-Qubit 4D \:d53c\:c154 \:d589\:b82c \:c815\:bc00 \:bd84\
\:c11d \:b9ac\:d3ec\:d2b8]\>\"", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", 
         "\"\<==================================================\>\"", "]"}], 
        ";", "\[IndentingNewLine]", 
